{
    "name": "liberusoftware/module-cms-hook-and-event-sdk",
    "description": "Stable typed hooks and events for Liberu CMS extensions.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-core": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\HookAndEventSdk\\": "src/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-hook-and-event-sdk"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\HookAndEventSdk\\HookAndEventSdkServiceProvider"
            ]
        }
    }
}
