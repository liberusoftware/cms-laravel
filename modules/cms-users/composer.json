{
    "name": "liberusoftware/module-cms-users",
    "description": "Identity & Access for Liberu CMS: the authorization boundary and permission registry every other module depends on.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-core": "^0.1",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-permission": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Users\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Users\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-users"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Users\\UsersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
