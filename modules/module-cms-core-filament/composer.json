{
    "name": "liberusoftware/module-cms-core-filament",
    "description": "Filament 5 presentation adapter for the Liberu CMS Core module.",
    "type": "liberu-module",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "liberusoftware/module-cms-core": "^0.1",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-admin": "^0.1"
    },
    "autoload": {"psr-4": {"Liberu\\Cms\\CoreFilament\\": "src/"}},
    "extra": {
        "liberu": {"name": "module-cms-core-filament", "core": "liberusoftware/module-cms-core"},
        "laravel": {"providers": ["Liberu\\Cms\\CoreFilament\\CoreFilamentServiceProvider"]}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
