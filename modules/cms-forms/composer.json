{
    "name": "liberusoftware/module-cms-forms",
    "description": "Forms module for Liberu CMS: public form definitions and spam-protected submissions that emit a FormSubmitted event.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-content": "^0.1",
        "liberusoftware/module-cms-core": "^0.1",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Forms\\": "src/",
            "Liberu\\Cms\\Forms\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Forms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-forms"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Forms\\CmsFormsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
