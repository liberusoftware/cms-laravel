{
    "name": "liberusoftware/module-cms-field-system-livewire",
    "description": "Livewire 4 adapter for the Liberu CMS Field System.",
    "type": "liberu-module",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "livewire/livewire": "^4.0",
        "liberusoftware/module-cms-content-entities": "^0.1"
    },
    "autoload": {"psr-4": {"Liberu\\Cms\\FieldSystemLivewire\\": "src/"}},
    "extra": {
        "liberu": {"name": "module-cms-field-system-livewire", "core": "liberusoftware/module-cms-content-entities"},
        "laravel": {"providers": ["Liberu\\Cms\\FieldSystemLivewire\\FieldSystemLivewireServiceProvider"]}
    }
}
