{
    "name": "liberusoftware/module-cms-themes",
    "description": "Theme engine for Liberu CMS: registration, inheritance, override resolution, and switching of Blade themes.",
    "type": "liberu-module",
    "license": "MIT",
    "homepage": "https://github.com/liberusoftware/module-cms-themes",
    "support": {
        "issues": "https://github.com/liberusoftware/module-cms-themes/issues",
        "source": "https://github.com/liberusoftware/module-cms-themes"
    },
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-core": "^0.1",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Themes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Themes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-themes"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Themes\\ThemesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
