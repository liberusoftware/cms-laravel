{
    "name": "liberusoftware/module-cms-notifications",
    "description": "Notifications module for Liberu CMS: turns CMS events into queued notifications delivered through channels (mail, log).",
    "type": "liberu-module",
    "license": "MIT",
    "homepage": "https://github.com/liberusoftware/module-cms-notifications",
    "support": {
        "issues": "https://github.com/liberusoftware/module-cms-notifications/issues",
        "source": "https://github.com/liberusoftware/module-cms-notifications"
    },
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-core": "^0.1",
        "filament/filament": "^5.0",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-notifications"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Notifications\\CmsNotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
