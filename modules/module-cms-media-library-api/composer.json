{
    "name": "liberusoftware/module-cms-media-library-api",
    "description": "HTTP API presentation adapter for the CMS Media Library.",
    "type": "liberu-module",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-media-library": "^0.1",
        "liberusoftware/module-cms-api": "^0.1",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0"
    },
    "autoload": {"psr-4": {"Liberu\\Cms\\MediaLibraryApi\\": "src/"}},
    "extra": {
        "liberu": {"name": "module-cms-media-library-api", "core": "liberusoftware/module-cms-media-library"},
        "laravel": {"providers": ["Liberu\\Cms\\MediaLibraryApi\\MediaLibraryApiServiceProvider"]}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
