{
    "name": "liberusoftware/module-cms-search",
    "description": "Search module for Liberu CMS: full-text search over published content across every content type, exposed on the Delivery API.",
    "type": "liberu-module",
    "license": "MIT",
    "homepage": "https://github.com/liberusoftware/module-cms-search",
    "support": {
        "issues": "https://github.com/liberusoftware/module-cms-search/issues",
        "source": "https://github.com/liberusoftware/module-cms-search"
    },
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-core": "^0.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/scout": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Search\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-search"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Search\\CmsSearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
