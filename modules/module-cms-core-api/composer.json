{
    "name": "liberusoftware/module-cms-core-api",
    "description": "HTTP API presentation adapter for the Liberu CMS Core module.",
    "type": "liberu-module",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-core": "^0.1",
        "liberusoftware/module-cms-contracts": "^0.1",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0"
    },
    "autoload": {"psr-4": {"Liberu\\Cms\\CoreApi\\": "src/"}},
    "extra": {
        "liberu": {"name": "module-cms-core-api", "core": "liberusoftware/module-cms-core"},
        "laravel": {"providers": ["Liberu\\Cms\\CoreApi\\CoreApiServiceProvider"]}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
