{
    "name": "liberusoftware/module-cms-content",
    "description": "Content foundation for Liberu CMS: editorial workflow and versioning shared by every content module.",
    "type": "liberu-module",
    "license": "MIT",
    "homepage": "https://github.com/liberusoftware/module-cms-content",
    "support": {
        "issues": "https://github.com/liberusoftware/module-cms-content/issues",
        "source": "https://github.com/liberusoftware/module-cms-content"
    },
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Content\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Content\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-content"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Content\\ContentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
