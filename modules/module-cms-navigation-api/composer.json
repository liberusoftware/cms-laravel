{
    "name": "liberusoftware/module-cms-navigation-api",
    "description": "Navigation API presentation module for Liberu CMS.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-menus": "^0.1",
        "liberusoftware/module-cms-contracts": "^0.1",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {"Liberu\\Cms\\NavigationApi\\": "src/"}
    },
    "extra": {
        "liberu": {"name": "module-cms-navigation-api", "core": "liberusoftware/module-cms-menus"},
        "laravel": {"providers": ["Liberu\\Cms\\NavigationApi\\NavigationApiServiceProvider"]}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
