APP_NAME="Liberu CMS"
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false. Leaving APP_DEBUG=true
# in production leaks stack traces and config. See docs/PRODUCTION-CHECKLIST.md.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

MULTITENANCY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=liberu_cms
DB_USERNAME=root
DB_PASSWORD=

# PRODUCTION: flip the cache/session/queue drivers to redis across multiple web
# nodes (see docs/PERFORMANCE.md). Local stays on database — zero-infra.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set true so session/auth cookies are only sent over HTTPS.
SESSION_SECURE_COOKIE=false

# HTTP security headers (config/security-headers.php). HSTS is safe on every
# environment (browsers ignore it over plain HTTP). The CSP ships report-only
# because Filament/Livewire use inline scripts; tune it, then set
# SECURITY_CSP_REPORT_ONLY=false to enforce.
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=true

# Require privileged roles (super_admin/admin) to enrol in 2FA before using the
# admin panel. See docs/REGISTRATION-ACCESS.md.
TWO_FACTOR_ENFORCE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# PRODUCTION: QUEUE_CONNECTION=redis and run Horizon for supervision + retries.
QUEUE_CONNECTION=database

# PRODUCTION: CACHE_STORE=redis for a shared cache across web nodes.
CACHE_STORE=database
# CACHE_PREFIX=

# Liberu CMS — observability & search (defaults are zero-infra; see
# docs/PERFORMANCE.md and docs/PRODUCTION-CHECKLIST.md for the production flip).
# Metrics default to an isolated log channel; bind a real recorder
# (Pulse/StatsD/Prometheus) to MetricsRecorderInterface for aggregation.
CMS_METRICS_ENABLED=true
CMS_METRICS_CHANNEL=cms-metrics
# Per-IP throttle (requests/min) on the public GET /health/ready probe.
CMS_READINESS_THROTTLE=60
# Search backend: database (LIKE, zero-infra) or scout (Meilisearch, production).
# For scout also set SCOUT_DRIVER=meilisearch + MEILISEARCH_HOST/MEILISEARCH_KEY.
SEARCH_DRIVER=database
# SendNotification retry attempts before it lands in failed_jobs.
NOTIFICATIONS_TRIES=3

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

HORIZON_PREFIX=horizon:

REVERB_APP_ID=your-reverb-app-id
REVERB_APP_KEY=your-reverb-app-key
REVERB_APP_SECRET=your-reverb-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
