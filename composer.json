{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "liberusoftware/cms-laravel",
    "type": "project",
    "description": "Liberu CMS: a modular Laravel application with API, Filament, and Livewire foundations.",
    "keywords": [
        "cms",
        "liberu",
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "bezhansalleh/filament-shield": "^4.0",
        "biostate/filament-menu-builder": "^5.0",
        "bursteri/socialstream": "^7.0",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.47",
        "laravel/jetstream": "^5.1",
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "liberusoftware/composer-installer": "^1.1",
        "liberusoftware/module-cms-admin": "^0.1",
        "liberusoftware/module-cms-api": "^0.1",
        "liberusoftware/module-cms-audit": "^0.1",
        "liberusoftware/module-cms-blocks": "^0.1",
        "liberusoftware/module-cms-content": "^0.1",
        "liberusoftware/module-cms-content-types": "^0.1",
        "liberusoftware/module-cms-content-entities-api": "^0.1",
        "liberusoftware/module-cms-content-entities-filament": "^0.1",
        "liberusoftware/module-cms-content-entities-livewire": "^0.1",
        "liberusoftware/module-cms-collections": "^0.1",
        "liberusoftware/module-cms-collections-livewire": "^0.1",
        "liberusoftware/module-cms-core-api": "^0.1",
        "liberusoftware/module-cms-core-filament": "^0.1",
        "liberusoftware/module-cms-core-livewire": "^0.1",
        "liberusoftware/module-cms-field-system-api": "^0.1",
        "liberusoftware/module-cms-field-system-filament": "^0.1",
        "liberusoftware/module-cms-field-system-livewire": "^0.1",
        "liberusoftware/module-cms-contracts": "^0.1",
        "liberusoftware/module-cms-forms": "^0.1",
        "liberusoftware/module-cms-core": "^0.1",
        "liberusoftware/module-cms-hello": "^0.1",
        "liberusoftware/module-cms-hello-livewire": "^0.1",
        "liberusoftware/module-cms-media": "^0.1",
        "liberusoftware/module-cms-menus": "^0.1",
        "liberusoftware/module-cms-notifications": "^0.1",
        "liberusoftware/module-cms-observability": "^0.1",
        "liberusoftware/module-cms-pages": "^0.1",
        "liberusoftware/module-cms-pages-api": "^0.1",
        "liberusoftware/module-cms-pages-filament": "^0.1",
        "liberusoftware/module-cms-pages-livewire": "^0.1",
        "liberusoftware/module-cms-personalization": "^0.1",
        "liberusoftware/module-cms-personalization-api": "^0.1",
        "liberusoftware/module-cms-personalization-filament": "^0.1",
        "liberusoftware/module-cms-personalization-livewire": "^0.1",
        "liberusoftware/module-cms-polls-and-surveys": "^0.1",
        "liberusoftware/module-cms-polls-and-surveys-api": "^0.1",
        "liberusoftware/module-cms-polls-and-surveys-filament": "^0.1",
        "liberusoftware/module-cms-polls-and-surveys-livewire": "^0.1",
        "liberusoftware/module-cms-publishing": "^0.1",
        "liberusoftware/module-cms-publishing-api": "^0.1",
        "liberusoftware/module-cms-publishing-filament": "^0.1",
        "liberusoftware/module-cms-publishing-livewire": "^0.1",
        "liberusoftware/module-cms-recommendations": "^0.1",
        "liberusoftware/module-cms-recommendations-api": "^0.1",
        "liberusoftware/module-cms-recommendations-filament": "^0.1",
        "liberusoftware/module-cms-recommendations-livewire": "^0.1",
        "liberusoftware/module-cms-redirects": "^0.1",
        "liberusoftware/module-cms-posts": "^0.1",
        "liberusoftware/module-cms-search": "^0.1",
        "liberusoftware/module-cms-seo": "^0.1",
        "liberusoftware/module-cms-themes": "^0.1",
        "liberusoftware/module-cms-users": "^0.1",
        "liberusoftware/module-cms-widgets": "^0.1",
        "livewire/livewire": "^4.0",
        "php": "^8.5",
        "spatie/laravel-passkeys": "^1.0",
        "spatie/laravel-permission": "^7.0",
        "stephenjude/filament-two-factor-authentication": "^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "infection/infection": "^0.34.0",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "5.x-dev",
        "pestphp/pest-plugin-laravel": "5.x-dev",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/composer-installer.git"
        },
        {
            "type": "path",
            "url": "modules/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": true
        },
        "allow-plugins": {
            "liberusoftware/composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
