{
    "name": "liberu-cms/cms-notifications",
    "description": "Notifications module for Liberu CMS: turns CMS events into queued notifications delivered through channels (mail, log).",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "liberu-cms/cms-contracts": "*",
        "liberu-cms/cms-core": "*",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Notifications\\CmsNotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
